# Godot 4+ specific ignores
.godot/
/android/

# Godot AI update staging, markers, and backups.
/addons/.godot_ai_update/

# Generated preview captures; existing reference overviews remain tracked.
/previews/

# Download cache; the renamed OFL subset, license and source digest are retained.
/art-source/ceramic/fonts/*.ttf
